{
  "name": "markdown-studio-monorepo",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/theoklitosBam7/markdown-studio#readme",
  "bugs": {
    "url": "https://github.com/theoklitosBam7/markdown-studio/issues"
  },
  "author": {
    "name": "Theoklitos Bampouris",
    "email": "th.bampouris@gmail.com",
    "url": "https://github.com/theoklitosBam7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theoklitosBam7/markdown-studio"
  },
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:pre:enter": "changeset pre enter next",
    "changeset:pre:exit": "changeset pre exit",
    "changeset:status": "changeset status",
    "changeset:validate-scopes": "node ./scripts/validate-changeset-scopes.mjs",
    "changeset:version": "changeset version",
    "dev": "vp run --filter @markdown-studio/web dev",
    "build": "vp run type-check && vp run --parallel --filter '@markdown-studio/*' build",
    "build:web": "vp run --filter @markdown-studio/web build",
    "build:landing": "vp run --filter @markdown-studio/landing build",
    "build:cli": "vp run --filter markdown-studio build",
    "build:npm": "vp run build:web && node ./scripts/stage-cli-package.mjs && vp run --filter markdown-studio build",
    "build:desktop": "vp run --filter @markdown-studio/desktop build",
    "dev:desktop": "vp run --filter @markdown-studio/desktop dev",
    "dist:mac": "vp run --filter @markdown-studio/desktop dist:mac",
    "preview": "vp run --filter @markdown-studio/web preview",
    "preview:desktop": "vp run --filter @markdown-studio/desktop preview",
    "test:unit": "vp run -r test",
    "test:scripts": "vp test run scripts/",
    "prepare": "cypress install && simple-git-hooks",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-desktop-icons": "node scripts/generate-desktop-icons.mjs",
    "test:e2e": "VITE_DISABLE_PWA=true vp run build:web && start-server-and-test 'vp -C apps/web preview --port 4175' http://localhost:4175 'cypress run --e2e --config baseUrl=http://localhost:4175'",
    "test:e2e:dev": "start-server-and-test 'VITE_DISABLE_PWA=true vp -C apps/web dev --port 4175' http://localhost:4175 'cypress open --e2e --config baseUrl=http://localhost:4175'",
    "type-check": "vue-tsc --build",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "pack:npm": "vp run build:npm && vp run --filter markdown-studio pack:check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.19.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-perfectionist": "^5.10.0",
    "nano-staged": "^1.0.2",
    "png-to-ico": "^3.0.2",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "start-server-and-test": "^3.0.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "vp exec nano-staged",
    "commit-msg": "vp exec commitlint --edit $1"
  },
  "nano-staged": {
    "*.{mjs,js,ts,vue,css,json,md}": "vp fmt",
    "*.{mjs,js,ts,vue}": [
      "vp lint --fix"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
